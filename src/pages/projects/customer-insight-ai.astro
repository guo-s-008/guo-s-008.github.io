---
const iterations = [
  {
    number: '01',
    title: '将业务建议误判为正式行动项',
    problem: '模型会把“建议排查”或“后续可以评估”识别为会议已经确认的行动。',
    action: '规定只有原文明示负责人、执行动作或下一步承诺时才输出正式行动，其余内容进入预行动或业务建议。',
    result: '规则化测试中的正式行动指标由 70.0% 提升至 75.0%。',
  },
  {
    number: '02',
    title: '多个独立诉求被合并',
    problem: '同一段讨论中的多个痛点可能被合并成一条需求，影响后续排序和入库。',
    action: '增加“一条需求只描述一个独立问题”的规则，并要求每条需求保留对应原文证据。',
    result: '需求拆分准确率由 95.8% 提升至 98.0%。',
  },
  {
    number: '03',
    title: '飞书文档和需求池写入失败',
    problem: '工作流运行到飞书写入阶段时出现资源地址或参数错误。',
    action: '检查权限、资源标识、插件参数和数据结构，改用飞书官方插件，并将循环结果转换为节点要求的数组对象。',
    result: '完成飞书文档创建、正文写入和多维表格需求记录写入验证。',
  },
  {
    number: '04',
    title: 'B 版本首次运行出现空输出',
    problem: '20 次首轮测试中有 4 次没有得到可解析结果。',
    action: '初步定位为模型输出被包装成字符串，计划增加 JSON 解析、类型校验、失败分支和重试机制。',
    result: '问题尚未彻底关闭，首轮运行成功率为 80%。',
  },
];

const metrics = [
  ['需求召回率', '74.2%', '81.3%'],
  ['决策召回率', '55.0%', '70.0%'],
  ['需求拆分准确率', '95.8%', '98.0%'],
  ['证据准确率', '91.1%', '96.2%'],
  ['Markdown 缺失率', '27.8%', '18.2%'],
  ['首轮运行成功率', '未记录', '80.0%'],
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>客户调研与需求分析 AI 助手 | 陈杰飞</title>
    <meta name="description" content="基于 Coze 的客户会议纪要分析、需求提取、历史案例匹配与飞书归档项目。" />
  </head>
  <body>
    <main>
      <nav class="nav shell">
        <a class="brand" href="/">陈杰飞</a>
        <div class="nav-links"><a href="/#projects">项目</a><a href="/#about">关于我</a></div>
      </nav>

      <header class="hero shell">
        <a class="back" href="/">返回作品集</a>
        <p class="eyebrow">Coze 工作流 · AI 产品运营实践</p>
        <h1>客户调研与需求分析<br />AI 助手</h1>
        <p class="lead">将会议纪要、用户访谈和客服反馈转化为结构化需求、历史案例匹配结果、业务分析报告及飞书需求池记录。</p>
        <div class="meta">
          <span><strong>时间</strong>2026.08</span>
          <span><strong>性质</strong>个人学习验证型 MVP</span>
          <span><strong>工具</strong>Coze · 飞书 · Excel</span>
          <span><strong>目标用户</strong>产品、运营、客户成功</span>
        </div>
        <div class="actions">
          <a class="button primary" href="#process">查看业务流程</a>
          <a class="button" href="/projects/customer-insight-ai/ab-test-results.xlsx" download>下载测试记录</a>
          <a class="button version-button" href="/projects/customer-insight-ai/versions/"><span>NEW</span>版本复盘</a>
        </div>
        <p class="data-note">页面展示内容均为模拟测试数据，不代表真实企业或客户。</p>
      </header>

      <section class="band muted">
        <div class="shell two-col">
          <div class="section-heading">
            <p class="eyebrow">Problem</p>
            <h2>为什么做这个项目</h2>
          </div>
          <div class="problem-list">
            <div><span>01</span><p>会议纪要篇幅长、重复内容多，人工整理和复盘耗时。</p></div>
            <div><span>02</span><p>客户痛点、独立需求、确认决策和行动项容易混在一起。</p></div>
            <div><span>03</span><p>历史反馈分散在邮件、工单和会议文档中，难以去重、检索和持续跟踪。</p></div>
          </div>
        </div>
      </section>

      <section class="band">
        <div class="shell two-col">
          <div class="section-heading">
            <p class="eyebrow">My role</p>
            <h2>我负责的部分</h2>
          </div>
          <div class="body-copy role-list">
            <p>识别客户反馈整理效率低、需求难拆分和历史案例难检索的问题，确定项目场景与目标用户。</p>
            <p>定义摘要、讨论重点、确认决策、独立需求、正式行动、预行动、未决问题和业务建议等结构化字段。</p>
            <p>使用 Coze 配置模型、代码、循环、判断和飞书写入节点，完成变量映射、条件分支和数据传递。</p>
            <p>在 AI 辅助下讨论 Prompt 和 JavaScript 处理方案，本人负责方案取舍、配置运行、测试核对和结果验收。</p>
            <p>建立 20 份模拟会议文本测试集，固定模型、Schema 和工作流节点，只调整提取 Prompt 进行 A/B 测试。</p>
          </div>
        </div>
      </section>

      <section class="band muted">
        <div class="shell">
          <div class="section-heading narrow">
            <p class="eyebrow">Before / After</p>
            <h2>从原始讨论到结构化需求</h2>
            <p>以下内容节选自模拟的“客户反馈知识库季度复盘”测试用例。</p>
          </div>
          <div class="comparison">
            <article class="input-panel">
              <p class="panel-label">原始输入节选</p>
              <blockquote>客户反馈散落在邮件、客服工单和各场会议纪要中。产品团队想统计同一个问题重复发生多少次，但用户描述用词不一致，不能简单依靠关键词自动合并。知识库需要保留用户原始表述、来源 ID 和发生时间，相似问题匹配结果必须支持人工复核。</blockquote>
            </article>
            <article class="output-panel">
              <p class="panel-label">结构化输出</p>
              <div class="output-item"><span>P1</span><p><strong>反馈结构化存储</strong>将分散的客户反馈整理为统一需求记录并保留原始证据。</p></div>
              <div class="output-item"><span>P1</span><p><strong>相似案例人工复核</strong>自动匹配结果需要保留人工校验入口。</p></div>
              <div class="output-item"><span>P2</span><p><strong>解决方案版本管理</strong>为历史答案增加版本和有效性标记。</p></div>
              <div class="output-item"><span>待评估</span><p><strong>高频问题自动周报</strong>尚未达成共识，不描述为确认开发。</p></div>
            </article>
          </div>
        </div>
      </section>

      <section id="process" class="band">
        <div class="shell">
          <div class="section-heading narrow">
            <p class="eyebrow">Process</p>
            <h2>业务处理流程</h2>
            <p>简化图解释业务阶段，真实工作流还包含变量生成、循环处理、条件分支和数据格式转换。</p>
          </div>
          <figure class="full-figure">
            <img src="/projects/customer-insight-ai/business-flow.svg" alt="客户调研与需求分析 AI 助手的七阶段业务流程" />
          </figure>
          <figure class="full-figure proof">
            <a href="/projects/customer-insight-ai/coze-workflow.png" target="_blank" rel="noreferrer"><img src="/projects/customer-insight-ai/coze-workflow.png" alt="Coze 完整工作流节点截图" /></a>
            <figcaption><strong>Coze 实际工作流配置</strong><span>点击图片可查看完整尺寸</span></figcaption>
          </figure>
        </div>
      </section>

      <section class="band muted">
        <div class="shell">
          <div class="section-heading narrow">
            <p class="eyebrow">Iteration</p>
            <h2>关键迭代与问题排查</h2>
            <p>项目不仅记录成功结果，也保留尚未关闭的稳定性问题。</p>
          </div>
          <div class="iterations">
            {iterations.map((item) => (
              <article>
                <span class="iteration-number">{item.number}</span>
                <div><h3>{item.title}</h3><p><strong>问题：</strong>{item.problem}</p><p><strong>调整：</strong>{item.action}</p><p class="result"><strong>结果：</strong>{item.result}</p></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="band">
        <div class="shell">
          <div class="section-heading narrow">
            <p class="eyebrow">Prompt A/B test</p>
            <h2>用相同测试集比较 Prompt 版本</h2>
            <p>固定模型、输入文本、Schema、循环和汇总逻辑，只调整信息提取节点 Prompt。自动评分用于观察版本变化，不替代人工语义复核。</p>
          </div>
          <div class="metrics-table" role="table" aria-label="Prompt A/B 测试主要指标">
            <div class="metric-row metric-head" role="row"><span>指标</span><span>Prompt A</span><span>Prompt B</span></div>
            {metrics.map((metric) => <div class="metric-row" role="row"><span>{metric[0]}</span><span>{metric[1]}</span><span>{metric[2]}</span></div>)}
          </div>
          <aside class="finding"><strong>测试结论</strong><p>Prompt B 在需求召回、决策识别、需求拆分和证据保留方面整体改善，但首轮运行成功率仅为 80%。内容质量提升不等于运行稳定性已经达标。</p></aside>
          <div class="evidence-grid">
            <figure><a href="/projects/customer-insight-ai/ab-test-overview.png" target="_blank" rel="noreferrer"><img src="/projects/customer-insight-ai/ab-test-overview.png" alt="A/B 测试自动指标对比总览" /></a><figcaption>A/B 测试总览</figcaption></figure>
            <figure><a href="/projects/customer-insight-ai/ab-test-criteria.png" target="_blank" rel="noreferrer"><img src="/projects/customer-insight-ai/ab-test-criteria.png" alt="A/B 测试指标判别基准" /></a><figcaption>测试指标与判别基准</figcaption></figure>
          </div>
        </div>
      </section>

      <section class="band muted">
        <div class="shell">
          <div class="section-heading narrow">
            <p class="eyebrow">Delivery</p>
            <h2>飞书报告与需求池归档</h2>
            <p>完成飞书文档创建、正文写入和多维表格记录写入验证，让分析结果能够继续筛选、复核和跟踪。</p>
          </div>
          <div class="evidence-grid delivery-grid">
            <figure><a href="/projects/customer-insight-ai/feishu-report.png" target="_blank" rel="noreferrer"><img src="/projects/customer-insight-ai/feishu-report.png" alt="飞书客户会议纪要与需求分析报告" /></a><figcaption>结构化分析报告</figcaption></figure>
            <figure><a href="/projects/customer-insight-ai/requirements-pool.png" target="_blank" rel="noreferrer"><img src="/projects/customer-insight-ai/requirements-pool.png" alt="飞书多维表格客户需求池" /></a><figcaption>飞书多维表格需求池</figcaption></figure>
          </div>
          <div class="download-row">
            <a class="button primary" href="/projects/customer-insight-ai/sample-report.pdf" target="_blank" rel="noreferrer">查看完整示例报告</a>
            <a class="button" href="/projects/customer-insight-ai/ab-test-results.xlsx" download>下载完整测试表</a>
          </div>
        </div>
      </section>

      <section class="band limitations">
        <div class="shell two-col">
          <div class="section-heading">
            <p class="eyebrow">Limitations</p>
            <h2>当前边界</h2>
          </div>
          <ul>
            <li>测试数据以模拟案例为主，尚未接入真实企业需求库。</li>
            <li>B 版本首轮运行成功率为 80%，字符串解析和异常处理仍需改善。</li>
            <li>自动评分依赖关键词与规则，不能替代人工语义复核。</li>
            <li>来源 ID 尚未稳定关联到每一条独立需求。</li>
            <li>历史案例以无匹配场景为主，复杂相似案例验证不足。</li>
            <li>新产生的需求尚未自动回写并反哺知识库。</li>
            <li>项目未经过真实企业生产环境的长期运行验证。</li>
          </ul>
        </div>
      </section>

      <footer class="footer shell"><span>© 2026 陈杰飞</span><a href="/">返回作品集</a></footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f7f9f7; color: #17231d; font-family: Inter, "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif; }
  :global(a) { color: inherit; }
  .shell { width: min(1160px, calc(100% - 64px)); margin: 0 auto; }
  .nav { height: 76px; display: flex; align-items: center; border-bottom: 1px solid #d9e1da; }
  .brand { margin-right: auto; text-decoration: none; font-weight: 760; }
  .nav-links { display: flex; gap: 28px; }
  .nav-links a { color: #526159; text-decoration: none; font-size: 14px; }
  .hero { padding: 68px 0 88px; }
  .back { display: inline-block; margin-bottom: 58px; color: #526159; font-size: 14px; text-decoration: none; }
  .eyebrow { margin: 0 0 16px; color: #39735b; text-transform: uppercase; letter-spacing: 0; font-size: 11px; font-weight: 760; }
  h1 { max-width: 900px; margin: 0; font-size: clamp(48px, 7vw, 82px); line-height: 1.06; letter-spacing: 0; }
  .lead { max-width: 760px; margin: 30px 0 0; color: #5d6b63; font-size: 19px; line-height: 1.75; }
  .meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 54px; border-top: 1px solid #d9e1da; border-bottom: 1px solid #d9e1da; }
  .meta span { padding: 20px 20px 20px 0; color: #526159; font-size: 14px; }
  .meta strong { display: block; margin-bottom: 7px; color: #17231d; font-size: 12px; }
  .actions, .download-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .button { display: inline-block; padding: 12px 18px; border: 1px solid #b9c9bd; color: #315c49; text-decoration: none; font-size: 14px; }
  .button.primary { background: #315c49; border-color: #315c49; color: #fff; }
  .version-button { display: inline-flex; align-items: center; gap: 8px; border-color: #8a6448; color: #6f4d36; }
  .version-button span { padding: 2px 5px; background: #8a6448; color: #fff; font-size: 9px; font-weight: 760; }
  .data-note { margin: 22px 0 0; color: #768279; font-size: 12px; }
  .band { padding: 92px 0; border-top: 1px solid #d9e1da; }
  .band.muted { background: #eef3ef; }
  .two-col { display: grid; grid-template-columns: minmax(240px, .8fr) minmax(0, 1.35fr); gap: 90px; }
  .section-heading h2 { margin: 0; font-size: 39px; line-height: 1.22; letter-spacing: 0; }
  .section-heading > p:last-child { max-width: 720px; color: #637068; font-size: 16px; line-height: 1.75; }
  .section-heading.narrow { max-width: 800px; margin-bottom: 40px; }
  .problem-list { display: grid; }
  .problem-list div { display: grid; grid-template-columns: 50px 1fr; gap: 20px; padding: 24px 0; border-bottom: 1px solid #d2dcd4; }
  .problem-list div:first-child { padding-top: 0; }
  .problem-list span { color: #39735b; font-size: 12px; font-weight: 760; }
  .problem-list p, .body-copy p { margin: 0; color: #4f5e55; line-height: 1.8; }
  .role-list { display: grid; gap: 0; counter-reset: role; }
  .role-list p { position: relative; padding: 18px 0 18px 42px; border-bottom: 1px solid #e0e6e1; }
  .role-list p::before { counter-increment: role; content: counter(role, decimal-leading-zero); position: absolute; left: 0; color: #39735b; font-size: 11px; font-weight: 760; }
  .comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .comparison article { padding: 30px; border: 1px solid #d8e1da; background: #fff; }
  .panel-label { margin: 0 0 24px; color: #39735b; font-size: 12px; font-weight: 760; }
  blockquote { margin: 0; color: #536158; font-size: 17px; line-height: 1.95; }
  .output-item { display: grid; grid-template-columns: 64px 1fr; gap: 14px; padding: 14px 0; border-bottom: 1px solid #e2e8e3; }
  .output-item:last-child { border-bottom: 0; }
  .output-item > span { align-self: start; padding: 5px 7px; background: #e8f1eb; color: #315c49; text-align: center; font-size: 11px; font-weight: 760; }
  .output-item p { margin: 0; color: #5a685f; line-height: 1.65; }
  .output-item strong { display: block; color: #17231d; }
  figure { margin: 0; }
  .full-figure { overflow: hidden; border: 1px solid #dbe3dd; background: #fff; }
  .full-figure img { display: block; width: 100%; height: auto; }
  .full-figure.proof { margin-top: 28px; }
  .full-figure.proof img { aspect-ratio: 16 / 7; object-fit: cover; object-position: center; }
  figcaption { display: flex; justify-content: space-between; gap: 20px; padding: 16px 18px; border-top: 1px solid #dbe3dd; color: #637068; font-size: 13px; }
  figcaption strong { color: #17231d; }
  .iterations { border-top: 1px solid #d2dcd4; }
  .iterations article { display: grid; grid-template-columns: 70px 1fr; gap: 24px; padding: 30px 0; border-bottom: 1px solid #d2dcd4; }
  .iteration-number { color: #39735b; font-size: 12px; font-weight: 760; }
  .iterations h3 { margin: 0 0 15px; font-size: 22px; }
  .iterations p { margin: 7px 0; color: #59675e; line-height: 1.7; }
  .iterations .result { color: #315c49; }
  .metrics-table { border-top: 2px solid #315c49; }
  .metric-row { display: grid; grid-template-columns: 1.4fr 1fr 1fr; border-bottom: 1px solid #dbe3dd; }
  .metric-row span { padding: 16px 14px; }
  .metric-row span:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
  .metric-head { background: #eef3ef; font-size: 12px; font-weight: 760; }
  .finding { display: grid; grid-template-columns: 150px 1fr; gap: 20px; margin: 30px 0 42px; padding: 25px; background: #f2eee6; border-left: 4px solid #8a6448; }
  .finding p { margin: 0; color: #59675e; line-height: 1.75; }
  .evidence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .evidence-grid figure { overflow: hidden; border: 1px solid #dbe3dd; background: #fff; }
  .evidence-grid img { display: block; width: 100%; aspect-ratio: 16 / 7; object-fit: cover; object-position: top left; }
  .delivery-grid img { aspect-ratio: 16 / 9; }
  .limitations ul { margin: 0; padding: 0; list-style: none; }
  .limitations li { position: relative; padding: 16px 0 16px 28px; border-bottom: 1px solid #dbe3dd; color: #536158; line-height: 1.7; }
  .limitations li::before { content: ''; position: absolute; top: 25px; left: 0; width: 8px; height: 8px; background: #8a6448; }
  .footer { display: flex; justify-content: space-between; padding: 32px 0 44px; border-top: 1px solid #d9e1da; color: #768279; font-size: 13px; }
  .footer a { color: #315c49; text-decoration: none; font-weight: 700; }
  @media (max-width: 800px) {
    .shell { width: min(100% - 40px, 1160px); }
    .hero { padding: 46px 0 68px; }
    .back { margin-bottom: 38px; }
    h1 { font-size: 48px; }
    .lead { font-size: 17px; }
    .meta { grid-template-columns: 1fr 1fr; }
    .two-col, .comparison, .evidence-grid { grid-template-columns: 1fr; gap: 38px; }
    .band { padding: 68px 0; }
    .section-heading h2 { font-size: 33px; }
    .full-figure.proof img { aspect-ratio: 4 / 3; }
    .evidence-grid img, .delivery-grid img { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 520px) {
    .nav-links { gap: 18px; }
    h1 { font-size: 40px; }
    .meta { grid-template-columns: 1fr; }
    .meta span { border-bottom: 1px solid #e1e7e2; }
    .comparison article { padding: 22px; }
    .output-item { grid-template-columns: 58px 1fr; }
    .iterations article { grid-template-columns: 40px 1fr; gap: 12px; }
    .metric-row { grid-template-columns: 1.35fr .8fr .8fr; font-size: 13px; }
