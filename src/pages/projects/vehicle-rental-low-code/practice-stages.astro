border-top:1px solid #d8e1da;color:#637068;font-size:12px}.footer{display:flex;justify-content:space-between;padding:32px 0 44px;border-top:1px solid #d9e1da;color:#768279;font-size:13px}.footer a{color:#315c49;text-decoration:none;font-weight:700}@media(max-width:800px){.shell{width:min(100% - 40px,1160px)}.hero{padding:46px 0 68px}.stage-nav>div{grid-template-columns:1fr 1fr}.stage-head{display:block}.text-link{display:inline-block;margin-top:20px}.shots{grid-template-columns:1fr 1fr}.band{padding:65px 0}}@media(max-width:520px){.nav-links{gap:16px}.nav-links a{font-size:13px}.stage-nav>div,.shots{grid-template-columns:1fr}.stage-head h2{font-size:29px}.path{flex-direction:column;gap:8px}.footer{flex-direction:column;gap:14px}}
</style>
