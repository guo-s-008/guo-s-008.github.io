.stage-copy{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:30px 0 24px}.stage-copy>div{padding:20px;background:#fff;border:1px solid #d8e1da}.stage-copy strong{display:block;margin-bottom:10px;color:#39735b;font-size:13px}.stage-copy p{margin:0;color:#4f5e55;line-height:1.8;font-size:14px}@media(max-width:800px){.stage-copy{grid-template-columns:1fr}}
