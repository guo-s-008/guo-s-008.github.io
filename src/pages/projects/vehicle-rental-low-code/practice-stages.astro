---
const stages = [
  ['01', '搭建平台入口与组织结构', '让后续的人员、岗位和业务数据有明确的组织归属。', '进入低代码平台，创建租车平台门户；在组织机构中建立集团及北京、上海、杭州分公司；检查门户菜单和组织层级是否可用。', '平台入口与组织层级先于业务表单建立，避免后续账号、权限和数据无处挂载。', 3],
  ['02', '准备基础资料', '把业务中反复引用的对象整理成可维护的主数据。', '进入数据组件/基础数据，建立客户、客户经理、车辆分类、车辆和费用类别；录入模拟资料并检查编号、名称、分类等字段。', '车辆分类与车辆资料分开维护，后续通过分组枚举控制车辆下拉选项，减少误选。', 3],
  ['03', '设计租赁单数据模型', '让一张租赁单能够承载基本信息和多条明细。', '新建租赁单主表，配置客户、日期、状态等基本字段；增加车辆信息和费用信息两个子表；设置字段类型、主从关联、必填和展示规则。', '主表保存单据级信息，子表保存车辆和费用明细，比把所有字段堆在一张表里更容易扩展。', 3],
  ['04', '配置业务表单与字段联动', '让制单岗按业务顺序填写，减少重复录入。', '将主表和子表组合成租赁单表单；选择客户后带出客户资料；先选择车辆分类，再筛选车辆；填写租赁周期、车辆信息和费用明细。', '操作路径是“先分类、再选车辆、再确认带出信息”，字段之间的联动直接服务于实际填写顺序。', 3],
  ['05', '加入公式与数据校验', '在提交之前拦截明显错误，并保持金额自动更新。', '在公式应用中将费用明细映射值相加生成合计金额；修改任意费用项后观察合计是否传递性更新；设置起租日期早于或等于归还日期的校验。', '日期不符合规则时系统阻止提交；费用不靠人工加总，所有明细变化都会重新计算合计。', 5],
  ['06', '配置岗位权限与审批工作流', '把业务职责落实为可执行的岗位边界和流转节点。', '为制单岗、收费岗、信息管理岗配置独立账号、菜单和操作权限；设计提交、收费审批、通过和驳回节点；分别登录账号验证可见和可操作范围。', '制单岗不能执行收费审批；驳回后不能继续处理原单，需要重新填写，制单岗只能查看驳回原因和表单信息。', 6],
  ['07', '建立查询列表并完成链路验证', '让管理岗位能追踪提交记录，并确认整个链路闭环。', '配置租赁单列表的字段、筛选条件和状态展示；使用不同岗位账号依次执行创建、提交、审批通过或驳回、重新填写和查询；记录各节点行为。', '信息管理岗可以查询全部提交记录和审批状态，最终验证字段联动、公式、校验、过滤、权限和流程是否一致。', 4],
];
---
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>七阶段实训操作证据 | 车辆租赁管理系统</title></head><body><main>
<nav class="nav shell"><a class="brand" href="/">陈杰飞</a><div class="nav-links"><a href="/projects/vehicle-rental-low-code/">项目概览</a><a href="/#projects">全部项目</a></div></nav>
<header class="hero shell"><a class="back" href="/projects/vehicle-rental-low-code/">返回项目页</a><p class="eyebrow">Practice evidence · 2024.12</p><h1>七阶段实训<br/>操作证据</h1><p class="lead">按实际操作路径整理的平台配置、业务规则和流程验证截图。每个阶段都说明“做什么、为什么做、截图证明什么”。</p><p class="note">材料边界：图片来自保留下来的实训任务材料和过程截图，使用模拟车辆租赁业务数据；不公开 SQL 和完整教案。</p></header>
<section class="band muted"><div class="shell stage-nav"><p class="eyebrow">Stages</p><div>{stages.map((s) => <a href={`#stage-${s[0]}`}><b>{s[0]}</b><span>{s[1]}</span></a>)}</div></div></section>
{stages.map((stage) => <section id={`stage-${stage[0]}`} class="band stage"><div class="shell"><div class="stage-head"><div><p class="eyebrow">Stage {stage[0]}</p><h2>{stage[1]}</h2><p>{stage[2]}</p></div><a class="text-link" href={`/projects/vehicle-rental-low-code/stages/stage-${stage[0]}/stage-${stage[0]}-notes.txt`} download>下载本阶段说明</a></div><div class="stage-copy"><div><strong>具体怎么做</strong><p>{stage[3]}</p></div><div><strong>我的判断与验证重点</strong><p>{stage[4]}</p></div></div><div class="path"><strong>操作路径</strong><span>{stage[1]} → 配置 → 保存 → 测试验证</span></div><div class="shots">{Array.from({length: stage[5]}, (_, i) => { const file = `step${stage[0]}-${String(i + 1).padStart(2, '0')}.png`; return <figure><a href={`/projects/vehicle-rental-low-code/stages/stage-${stage[0]}/${file}`} target="_blank" rel="noreferrer"><img src={`/projects/vehicle-rental-low-code/stages/stage-${stage[0]}/${file}`} alt={`${stage[1]}操作截图 ${i + 1}`}/></a><figcaption>阶段 {stage[0]} · 操作截图 {i + 1}</figcaption></figure>; })}</div></div></section>)}
<footer class="footer shell"><span>© 2026 陈杰飞</span><a href="/projects/vehicle-rental-low-code/">返回项目概览</a></footer></main></body></html>
