ign-items:center;gap:15px;flex-wrap:wrap;margin-top:28px}.flow span{padding:11px 15px;border:1px solid #cbbda9;background:#fff;font-size:14px;font-weight:700}.flow i{color:#8a6448;font-style:normal}.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.summary-grid article{padding:28px;border:1px solid #d8e1da;background:#fff}.summary-grid h3{margin:0 0 18px;font-size:20px}.summary-grid ul{margin:0;padding-left:19px}.summary-grid li{margin:10px 0;color:#59675e;line-height:1.7}.note{display:grid;grid-template-columns:100px 1fr;gap:20px;margin-top:28px;padding:24px;border-left:4px solid #39735b;background:#fff}.note p{margin:0;color:#59675e;line-height:1.7}.footer{display:flex;justify-content:space-between;padding:32px 0 44px;border-top:1px solid #d9e1da;color:#768279;font-size:13px}.footer a{color:#315c49;text-decoration:none;font-weight:700}@media(max-width:800px){.shell{width:min(100% - 40px,1160px)}.hero{padding:46px 0 68px}.back{margin-bottom:38px}h1{font-size:46px}.meta,.summary-grid{grid-template-columns:1fr 1fr}.band{padding:68px 0}.section-heading h2,.turning-point h2{font-size:33px}}@media(max-width:520px){.nav-links{gap:16px}h1{font-size:38px}.meta,.summary-grid{grid-template-columns:1fr}.meta span{border-bottom:1px solid #e1e7e2}.finding-list article{grid-template-columns:38px 1fr;gap:10px}.turning-point{padding:24px}.flow{align-items:stretch;flex-direction:column}.flow i{transform:rotate(90deg);align-self:center}.note{grid-template-columns:1fr}.footer{flex-direction:column;gap:14px}}
